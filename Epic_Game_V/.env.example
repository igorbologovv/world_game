POSTGRES_USER=epic_game
POSTGRES_PASSWORD=epic_game_local_password
POSTGRES_DB=epic_game
POSTGRES_PORT=15433
GAME_PORT=3011
# Used by cargo run on the host. Compose supplies its own internal database URL.
DATABASE_URL=postgres://epic_game:epic_game_local_password@127.0.0.1:15433/epic_game
ECONOMY_SERVICE_ADDR=127.0.0.1:3011
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
RUST_LOG=info
